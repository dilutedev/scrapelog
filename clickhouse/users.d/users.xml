<clickhouse>
    <profiles>
        <ingest_writer>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
        </ingest_writer>
        <grafana_reader>
            <readonly>1</readonly>
            <max_memory_usage>2147483648</max_memory_usage>
            <max_execution_time>60</max_execution_time>
            <max_bytes_before_external_group_by>1073741824</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1073741824</max_bytes_before_external_sort>
            <max_result_rows>100000</max_result_rows>
        </grafana_reader>
    </profiles>
    <users>
        <ingest_writer>
            <password from_env="CLICKHOUSE_INGEST_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>ingest_writer</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT, SELECT ON scrapelog.requests</query>
                <query>GRANT INSERT, SELECT ON scrapelog.api_keys</query>
                <query>GRANT SHOW TABLES ON scrapelog.*</query>
                <query>GRANT SHOW TABLES ON system.*</query>
                <query>GRANT SELECT ON system.parts</query>
            </grants>
        </ingest_writer>
        <grafana_reader>
            <password from_env="CLICKHOUSE_READER_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>grafana_reader</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON scrapelog.requests</query>
                <query>GRANT SELECT ON scrapelog.requests_hourly</query>
                <query>GRANT SHOW TABLES ON scrapelog.*</query>
                <query>GRANT SHOW TABLES ON system.*</query>
                <query>GRANT SELECT ON system.parts</query>
            </grants>
        </grafana_reader>
    </users>
</clickhouse>
