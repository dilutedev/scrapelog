            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sumMerge(request_count) AS requests FROM scrapelog.requests_hourly WHERE $__timeFilter(hour) AND project IN (${project:singlequote}) AND scraper IN (${scraper:singlequote}) AND domain IN (${domain:singlequote})"
        }
