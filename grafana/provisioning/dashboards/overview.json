          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT quantilesMerge(0.5, 0.95, 0.99)(latency_quantiles)[1] AS median_latency_ms FROM scrapelog.requests_hourly WHERE $__timeFilter(hour) AND project IN (${project:singlequote}) AND scraper IN (${scraper:singlequote}) AND domain IN (${domain:singlequote})"
