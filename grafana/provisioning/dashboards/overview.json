    {
      "id": 5,
      "title": "Requests by status class",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(hour) AS time, multiIf(status = 0, '0', concat(toString(intDiv(status, 100)), 'xx')) AS status_class, sumMerge(request_count) AS requests FROM scrapelog.requests_hourly WHERE $__timeFilter(hour) AND project IN (${project:singlequote}) AND scraper IN (${scraper:singlequote}) AND domain IN (${domain:singlequote}) GROUP BY time, status_class ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.status_class}",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
