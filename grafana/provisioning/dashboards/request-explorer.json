    {
      "id": 1,
      "title": "Recent requests (newest 500)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ts AS time, project, scraper, method, status, domain, path(url) AS path, latency_ms, proxy, tls_profile, error, request_id FROM scrapelog.requests WHERE $__timeFilter(ts) AND project IN (${project:singlequote}) AND scraper IN (${scraper:singlequote}) AND domain IN (${domain:singlequote}) AND status IN (${status:singlequote}) AND (decodeURLComponent('${url_contains:percentencode}') = '' OR positionCaseInsensitive(url, decodeURLComponent('${url_contains:percentencode}')) > 0) AND (decodeURLComponent('${tls_ja4:percentencode}') = '' OR tls_ja4 = decodeURLComponent('${tls_ja4:percentencode}')) ORDER BY ts DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 175
              },
              {
