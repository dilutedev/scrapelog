      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT name AS field, value FROM scrapelog.requests ARRAY JOIN ['request_id', 'ts', 'received_at', 'project', 'scraper', 'method', 'url', 'status', 'latency_ms', 'response_size', 'proxy', 'http_version', 'tls_profile', 'tls_ja3', 'tls_ja4', 'error', 'body_key'] AS name, [request_id, toString(ts), toString(received_at), project, scraper, method, url, toString(status), toString(latency_ms), toString(response_size), proxy, http_version, tls_profile, tls_ja3, tls_ja4, error, body_key] AS value WHERE $__timeFilter(ts) AND request_id = decodeURLComponent('${request_id:percentencode}') LIMIT 17"
        }
      ],
